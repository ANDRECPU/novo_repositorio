#include <stdio.h>

int main() {
    int altura, tipo;

    // Entrada de dados
    printf("Digite a altura do triangulo: ");
    scanf("%d", &altura);

    printf("Triangulo preenchido: 1\nTriangulo vazado: 0\nEscolha a opcao: ");
    scanf("%d", &tipo);

    // Escolha com switch
    switch(tipo) {
        case 1: // Triângulo preenchido
            for(int i = 1; i <= altura; i++) {
                for(int j = 1; j <= i; j++) {
                    printf("*");
                }
                printf("\n");
            }
            break;

        case 0: // Triângulo vazado
            for(int i = 1; i <= altura; i++) {
                if(i == 1) {
                    // Primeira linha: só um *
                    printf("*\n");
                } else if(i == 2) {
                    // Segunda linha: dois *
                    printf("**\n");
                } else if(i < altura) {
                    // Linhas intermediárias: * + espaços + *
                    printf("*");
                    for(int j = 1; j <= i - 2; j++) {
                        printf(" ");
                    }
                    printf("*\n");
                } else {
                    // Última linha: cheia de *
                    for(int j = 1; j <= altura; j++) {
                        printf("*");
                    }
                    printf("\n");
                }
            }
            break;

        default:
            printf("Opcao invalida!\n");
            break;
    }

    return 0;
}
