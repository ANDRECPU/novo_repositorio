#include <stdio.h>

int main() {
    int largura;

    printf("Digite a largura central do losango (impar): ");
    scanf("%d", &largura);

    // Parte superior
    for(int i = 1; i <= largura; i += 2) {
        // Espaços à esquerda
        for(int j = 0; j < (largura - i) / 2; j++) {
            printf(" ");
        }
        // X
        for(int j = 0; j < i; j++) {
            printf("x");
        }
        printf("\n");
    }

    // Parte inferior
    for(int i = largura - 2; i >= 1; i -= 2) {
        // Espaços à esquerda
        for(int j = 0; j < (largura - i) / 2; j++) {
            printf(" ");
        }
        // X
        for(int j = 0; j < i; j++) {
            printf("x");
        }
        printf("\n");
    }

    return 0;
}
