#include <stdio.h>

int main() {
    int B, L, A;

    // Entrada com validação
    do {
        printf("Digite o valor de B (impar >= 3): ");
        scanf("%d", &B);
    } while(B < 3 || B % 2 == 0);

    do {
        printf("Digite a largura do tronco L (impar >=1 e <= B/2): ");
        scanf("%d", &L);
    } while(L < 1 || L % 2 == 0 || L > B/2);

    do {
        printf("Digite a altura do tronco A (>=2 e <= B/2): ");
        scanf("%d", &A);
    } while(A < 2 || A > B/2);

    // Parte da árvore (copa)
    for(int i = 1; i <= B; i += 2) {
        for(int j = 0; j < (B - i) / 2; j++) {
            printf(" ");
        }
        for(int j = 0; j < i; j++) {
            printf("*");
        }
        printf("\n");
    }

    // Tronco
    for(int i = 0; i < A; i++) {
        for(int j = 0; j < (B - L) / 2; j++) {
            printf(" ");
        }
        for(int j = 0; j < L; j++) {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}

